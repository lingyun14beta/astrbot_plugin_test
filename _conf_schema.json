{
  "api_key": {
    "description": "API 密钥（string 类型 + obvious_hint）",
    "type": "string",
    "obvious_hint": true,
    "hint": "在此填入你的 API Key",
    "default": ""
  },
  "prompt_template": {
    "description": "提示词模板（text 类型，显示为大文本框）",
    "type": "text",
    "hint": "支持使用 {keyword} 作为占位符",
    "default": "请根据以下关键词生成内容：{keyword}"
  },
  "max_retries": {
    "description": "最大重试次数（int 类型 + slider）",
    "type": "int",
    "default": 3,
    "hint": "API 调用失败时的最大重试次数",
    "slider": {
      "min": 1,
      "max": 10,
      "step": 1
    }
  },
  "temperature": {
    "description": "温度参数（float 类型 + slider）",
    "type": "float",
    "default": 0.7,
    "hint": "控制输出的随机性，范围 0-2",
    "slider": {
      "min": 0,
      "max": 2,
      "step": 0.1
    }
  },
  "enable_debug": {
    "description": "启用调试模式（bool 类型 + obvious_hint）",
    "type": "bool",
    "default": false,
    "hint": "开启后会在日志中输出详细调试信息"
  },
  "output_mode": {
    "description": "输出模式（string 类型 + options 下拉 + labels）",
    "type": "string",
    "default": "text",
    "options": ["text", "image", "mixed"],
    "labels": ["纯文本", "图片", "混合输出"],
    "hint": "选择插件的输出方式"
  },
  "llm_provider": {
    "description": "LLM 提供商（_special: select_provider）",
    "type": "string",
    "default": "",
    "hint": "选择一个已配置的 LLM 提供商",
    "_special": "select_provider"
  },
  "bot_persona": {
    "description": "Bot 人设（_special: select_persona）",
    "type": "string",
    "default": "",
    "hint": "选择一个已配置的人设",
    "_special": "select_persona"
  },
  "knowledge_bases": {
    "description": "知识库（_special: select_knowledgebase，list 类型）",
    "type": "list",
    "default": [],
    "hint": "选择要使用的知识库（支持多选）",
    "_special": "select_knowledgebase"
  },
  "internal_config": {
    "description": "内部配置（invisible 隐藏配置项）",
    "type": "string",
    "default": "secret_value",
    "invisible": true
  },
  "adv_intro": {
    "description": "高级功能说明（collapsed 默认折叠）",
    "type": "text",
    "default": "以下为高级配置，按需开启。",
    "collapsed": true,
    "hint": "这是一个默认折叠的说明区域，展开后可见下方子配置"
  },
  "adv_feature_enabled": {
    "description": "启用高级功能",
    "type": "bool",
    "default": false,
    "hint": "开启后，下方高级选项会展开"
  },
  "adv_mode": {
    "description": "高级模式（condition 条件显示）",
    "type": "string",
    "options": ["fast", "quality"],
    "labels": ["快速模式", "质量模式"],
    "default": "fast",
    "collapsed": true,
    "condition": {
      "adv_feature_enabled": true
    },
    "hint": "仅在开启高级功能后可见"
  },
  "custom_script": {
    "description": "自定义脚本（editor_mode 代码编辑器模式）",
    "type": "text",
    "default": "{}",
    "hint": "输入自定义配置",
    "editor_mode": true,
    "editor_language": "json",
    "editor_theme": "vs-dark"
  },
  "system_prompt": {
    "description": "系统提示词（editor_language markdown）",
    "type": "text",
    "default": "# 系统提示词\n\n请在此编写...",
    "hint": "使用 Markdown 编辑器编写提示词",
    "editor_mode": true,
    "editor_language": "markdown"
  },
  "supported_platforms": {
    "description": "支持的平台（list 多选 + render_type checkbox）",
    "type": "list",
    "items": {"type": "string"},
    "options": ["aiocqhttp", "telegram", "wecom", "lark", "discord"],
    "labels": ["QQ", "Telegram", "企业微信", "飞书", "Discord"],
    "default": ["aiocqhttp"],
    "hint": "选择插件启用的平台（多选）"
  },
  "uploaded_files": {
    "description": "上传文件（file 类型）",
    "type": "file",
    "default": [],
    "hint": "上传插件需要的文件",
    "file_types": ["pdf", "docx", "txt", "png", "jpg"]
  },
  "nested_config": {
    "description": "嵌套配置（object 类型 + items）",
    "type": "object",
    "hint": "包含子配置项的嵌套对象",
    "items": {
      "host": {
        "description": "服务器地址",
        "type": "string",
        "default": "localhost"
      },
      "port": {
        "description": "端口号",
        "type": "int",
        "default": 8080
      },
      "use_ssl": {
        "description": "启用 SSL",
        "type": "bool",
        "default": false
      }
    }
  },

  "custom_headers": {
    "description": "自定义请求头（dict 类型 + template_schema）",
    "type": "dict",
    "items": {},
    "default": {},
    "hint": "添加自定义 HTTP 请求头，可用 template_schema 快速编辑",
    "template_schema": {
      "Content-Type": {
        "name": "Content-Type",
        "description": "内容类型",
        "hint": "如 application/json",
        "type": "string",
        "default": "application/json"
      },
      "Authorization": {
        "name": "Authorization",
        "description": "认证令牌",
        "hint": "Bearer token 或其他认证信息",
        "type": "string",
        "default": ""
      },
      "timeout": {
        "name": "请求超时",
        "description": "超时时间（秒）",
        "hint": "范围 1-120 秒",
        "type": "int",
        "default": 30,
        "slider": {"min": 1, "max": 120, "step": 1}
      }
    }
  },

  "scheduled_tasks": {
    "description": "定时任务（template_list 类型）",
    "type": "template_list",
    "hint": "配置定时执行的任务列表",
    "templates": {
      "cron_task": {
        "name": "Cron 定时任务",
        "hint": "使用 cron 表达式设置定时触发",
        "display_item": "cron_expression",
        "hide_hint_in_list": true,
        "items": {
          "cron_expression": {
            "description": "Cron 表达式",
            "type": "string",
            "default": "0 0 * * *"
          },
          "task_prompt": {
            "description": "任务提示词",
            "type": "text",
            "default": ""
          },
          "enabled": {
            "description": "是否启用",
            "type": "bool",
            "default": true
          }
        }
      },
      "interval_task": {
        "name": "间隔任务",
        "hint": "按固定间隔触发任务",
        "items": {
          "interval_seconds": {
            "description": "间隔秒数",
            "type": "int",
            "default": 3600
          },
          "task_prompt": {
            "description": "任务提示词",
            "type": "text",
            "default": ""
          },
          "enabled": {
            "description": "是否启用",
            "type": "bool",
            "default": false
          }
        }
      }
    }
  }
}
